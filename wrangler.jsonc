{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2czcom",
  "keep_vars": true,
  "main": "server/worker.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/auth", "/api/auth/*"]
  }
}

